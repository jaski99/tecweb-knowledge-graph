{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/tecweb-kg/node.schema.json",
  "title": "Nodo del knowledge graph — Tecnologie Web (schema v4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "area",
    "gruppo",
    "tipo",
    "sapere",
    "saper_fare",
    "prerequisiti",
    "esercizi",
    "tempo_studio_min",
    "priorita",
    "risorse",
    "riferimenti_testo",
    "worker"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Identificatore unico in kebab-case, senza prefisso area"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Titolo del nodo in italiano"
    },
    "area": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Area tematica (1=Fondamenti rete e HTTP, 2=Architetture, 3=Front-end, 4=Back-end e strumenti, 5=Web semantico, 6=Tesina, 7=Modulo IA - apprendimento automatico, serve per la lode)"
    },
    "gruppo": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "Classificazione dal materiale utente: A=iper-riciclati (~65%), B=varianti (~20%), C=punti ciechi (~15%)"
    },
    "worker": {
      "type": "string",
      "enum": ["W1", "W2", "W3", "W4", "W5", "X1", "X2", "X3", "X4", "X5", "X6"],
      "description": "Worker che ha creato o rivisto il nodo: W1-W5 = round 1 (docs/ARENA_PLAN.md), X1-X6 = round 2 (docs/IMPROVEMENT_PLAN.md)"
    },
    "tipo": {
      "enum": [
        "concetto",
        "abilita",
        "tipo_esercizio"
      ],
      "description": "Tipo di nodo: concetto=teoria, abilita=procedura, tipo_esercizio=famiglia di esercizi d'esame"
    },
    "sapere": {
      "type": "string",
      "minLength": 10,
      "description": "Cosa si deve conoscere (1-4 frasi)"
    },
    "saper_fare": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      },
      "description": "Criteri osservabili (verbi d'azione), ~2-4"
    },
    "prerequisiti": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "forza",
          "motivo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ID di un nodo esistente"
          },
          "forza": {
            "enum": [
              "hard",
              "soft"
            ],
            "description": "hard = indispensabile; soft = utile"
          },
          "motivo": {
            "type": "string",
            "minLength": 5,
            "description": "Motivazione del prerequisito"
          }
        }
      },
      "description": "Prerequisiti: id esistenti, niente self-loop; nessun ciclo considerando archi hard+soft"
    },
    "esercizi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo_esame",
          "testo",
          "soluzione"
        ],
        "properties": {
          "tipo_esame": {
            "type": "string",
            "minLength": 3,
            "description": "Tipo di esercizio d'esame (es. 'scritto: domanda HTTP')"
          },
          "testo": {
            "type": "string",
            "minLength": 5,
            "description": "Testo dell'esercizio"
          },
          "soluzione": {
            "type": "string",
            "minLength": 10,
            "description": "Soluzione breve, passo-passo"
          }
        }
      },
      "description": "Mini-esempi svolti. minItems 1 se tipo è abilita o tipo_esercizio"
    },
    "tempo_studio_min": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600,
      "description": "Tempo di studio minimo in minuti"
    },
    "priorita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "livello",
        "motivazione"
      ],
      "properties": {
        "livello": {
          "enum": [
            "alta",
            "media",
            "bassa"
          ],
          "description": "Livello di priorità"
        },
        "motivazione": {
          "type": "string",
          "minLength": 5,
          "description": "Motivazione legata a programma + testi + gruppo A/B/C"
        }
      },
      "description": "Priorità: motivazione basata su gruppo A/B/C e formato d'esame IPOTIZZATO"
    },
    "risorse": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titolo",
          "url",
          "verificato"
        ],
        "properties": {
          "titolo": {
            "type": "string",
            "description": "Titolo della risorsa"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "URL assoluto con protocollo"
          },
          "verificato": {
            "const": true,
            "description": "La risorsa è stata verificata con scripts/check_urls.py (HTTP 200)"
          }
        }
      },
      "description": "Risorse esterne verificabili (HTTP 200)"
    },
    "riferimenti_testo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "libro"
        ],
        "properties": {
          "libro": {
            "enum": [
              "MDN",
              "RFC",
              "W3C",
              "FLASK",
              "GIT",
              "ECMA",
              "SQLITE",
              "PYTHON",
              "NUMPY",
              "SKLEARN",
              "REACT"
            ],
            "description": "Chiave in testi (meta.json)"
          },
          "capitolo_o_sezione": {
            "type": "string",
            "minLength": 1,
            "description": "Sezione specifica (opzionale, solo se verificato su indice reale)"
          }
        }
      },
      "description": "Riferimenti a testi di riferimento"
    },
    "checklist_ripasso": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "description": "Punti flash per il ripasso finale (opzionale)"
    },
    "lezione": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perche_ti_serve",
        "scenario_fil_rouge",
        "definizione_esame",
        "spiegazione",
        "analogia",
        "worked_example",
        "completion_problem",
        "esercizio_autonomo",
        "errori_trappole",
        "richiamo_attivo",
        "riepilogo",
        "flashcard",
        "checklist"
      ],
      "properties": {
        "perche_ti_serve": {
          "type": "string",
          "minLength": 20,
          "maxLength": 200,
          "description": "1-2 righe: dove esce all'esame, gruppo A/B/C, quanti punti vale"
        },
        "scenario_fil_rouge": {
          "type": "string",
          "minLength": 50,
          "description": "Storia/scenario concreto fil rouge (es. carrello e-commerce, biblioteca) riusato in tutto il corso"
        },
        "definizione_esame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definizione", "scopo_vantaggio", "esempio"],
          "properties": {
            "definizione": {
              "type": "string",
              "minLength": 10,
              "description": "Definizione esatta da memorizzare"
            },
            "scopo_vantaggio": {
              "type": "string",
              "minLength": 10,
              "description": "Scopo o vantaggio principale"
            },
            "esempio": {
              "type": "string",
              "minLength": 10,
              "description": "Esempio concreto"
            }
          },
          "description": "Definizione d'esame esatta con la regola dei 3 punti"
        },
        "spiegazione": {
          "type": "string",
          "minLength": 1500,
          "description": "Spiegazione a piccoli blocchi (un'idea per blocco, frasi brevi), con ##/###, >=1 blocco code o mermaid; mermaid valido"
        },
        "analogia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testo", "limite"],
          "properties": {
            "testo": {
              "type": "string",
              "minLength": 40,
              "description": "Analogia della vita quotidiana"
            },
            "limite": {
              "type": "string",
              "minLength": 10,
              "description": "Dove l'analogia smette di funzionare"
            }
          },
          "description": "Analogia quotidiana + limite"
        },
        "worked_example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titolo", "problema", "passi", "soluzione", "perche_funziona"],
          "properties": {
            "titolo": {"type": "string", "minLength": 3, "description": "Titolo dell'esempio"},
            "problema": {"type": "string", "minLength": 20, "description": "Descrizione del problema"},
            "passi": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 5},
              "description": "Passi numerati per risolvere il problema"
            },
            "soluzione": {"type": "string", "minLength": 10, "description": "Soluzione completa"},
            "perche_funziona": {"type": "string", "minLength": 20, "description": "Spiegazione del perché la soluzione funziona"}
          },
          "description": "Esempio svolto completo passo passo"
        },
        "completion_problem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titolo", "testo", "passi_mancanti", "soluzione"],
          "properties": {
            "titolo": {"type": "string", "minLength": 3, "description": "Titolo del completion problem"},
            "testo": {"type": "string", "minLength": 20, "description": "Testo del problema con passi mancanti"},
            "passi_mancanti": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 5},
              "description": "Passi che l'utente deve completare"
            },
            "soluzione": {"type": "string", "minLength": 10, "description": "Soluzione completa con passi mancanti riempiti"}
          },
          "description": "Completion problem: passi mancanti da riempire"
        },
        "esercizio_autonomo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titolo", "testo", "suggerimento", "soluzione_attesa"],
          "properties": {
            "titolo": {"type": "string", "minLength": 3, "description": "Titolo dell'esercizio autonomo"},
            "testo": {"type": "string", "minLength": 20, "description": "Testo dell'esercizio"},
            "suggerimento": {"type": "string", "minLength": 10, "description": "Suggerimento per l'esercizio"},
            "soluzione_attesa": {"type": "string", "minLength": 10, "description": "Soluzione attesa"}
          },
          "description": "Esercizio autonomo per fading graduale"
        },
        "errori_trappole": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["errore", "perche_sbagliato", "distrattore"],
            "properties": {
              "errore": {"type": "string", "minLength": 10, "description": "Errore comune o trappola d'esame"},
              "perche_sbagliato": {"type": "string", "minLength": 10, "description": "Spiegazione del perché è sbagliato"},
              "distrattore": {"type": "string", "minLength": 5, "description": "Distrattore fuori contesto"}
            }
          },
          "description": "Errori comuni e trappole d'esame con distrattori fuori contesto"
        },
        "mnemonica": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Mnemonica/immagine mentale (acronimi, loci, storiella) opzionale"
        },
        "richiamo_attivo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domande", "spiega_con_parole_tue", "collegamenti_interleaving"],
          "properties": {
            "domande": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["domanda", "risposta"],
                "properties": {
                  "domanda": {"type": "string", "minLength": 10},
                  "risposta": {"type": "string", "minLength": 10}
                }
              },
              "description": "3-5 domande di autoverifica con risposta nascosta"
            },
            "spiega_con_parole_tue": {
              "type": "string",
              "minLength": 20,
              "description": "Domanda per spiegare con parole proprie"
            },
            "collegamenti_interleaving": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodo", "collegamento"],
                "properties": {
                  "nodo": {"type": "string", "description": "ID di un nodo esistente"},
                  "collegamento": {"type": "string", "minLength": 20, "description": "Come si collega al nodo"}
                }
              },
              "description": "Collegamenti a nodi precedenti per interleaving"
            }
          },
          "description": "Richiamo attivo: 3-5 domande + spiega con parole tue + collegamenti interleaving"
        },
        "riepilogo": {
          "type": "string",
          "minLength": 40,
          "maxLength": 800,
          "description": "Riepilogo in 5 righe"
        },
        "flashcard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fronte", "retro"],
          "properties": {
            "fronte": {"type": "string", "minLength": 5, "description": "Fronte della flashcard"},
            "retro": {"type": "string", "minLength": 5, "description": "Retro della flashcard"}
          },
          "description": "Flashcard per il ripasso SM-2 (fronte/retro)"
        },
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["so_fare", "so_dire"],
          "properties": {
            "so_fare": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 3},
              "description": "Cose che so fare"
            },
            "so_dire": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 3},
              "description": "Cose che so dire/spiegare"
            }
          },
          "description": "Checklist so fare / so dire"
        }
      },
      "description": "Lezione v4: struttura in 10 punti secondo DIDATTICA.md (opzionale nello schema, obbligatorio per completezza)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"tipo": {"enum": ["abilita", "tipo_esercizio"]}},
        "required": ["tipo"]
      },
      "then": {"properties": {"esercizi": {"minItems": 1}}}
    }
  ]
}
